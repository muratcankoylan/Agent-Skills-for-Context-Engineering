# Copy to .env and fill in your keys. .env is gitignored; never commit real keys.
#
#   cp .env.example .env
#
# The CLI loads .env automatically from this directory or any parent. Values
# already present in the real environment always win, so exported shell vars and
# platform-injected secrets are never overwritten by this file.

# ---------------------------------------------------------------------------
# Generation and judging (required for live runs)
# ---------------------------------------------------------------------------

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Detector diagnostic (optional)
# ---------------------------------------------------------------------------

# Pangram: https://www.pangram.com/ -- reported as a benchmark column only.
# Never used as an optimization signal inside the writing loop. Leave blank to
# skip the detector column entirely.
PANGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Model pinning (optional but recommended for reproducible benchmarks)
# ---------------------------------------------------------------------------
# Defaults are floating aliases. Pin dated snapshots before any benchmark run
# you intend to publish, otherwise results are not comparable across days.
# Check current IDs:
#   https://docs.anthropic.com/en/docs/about-claude/models
#   https://platform.openai.com/docs/models

# DWL_ANTHROPIC_MODEL=claude-opus-4-1
# DWL_OPENAI_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Endpoint overrides (optional; for proxies, gateways, or local replicas)
# ---------------------------------------------------------------------------

# DWL_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
# DWL_OPENAI_URL=https://api.openai.com/v1/chat/completions
# DWL_PANGRAM_URL=https://text.api.pangramlabs.com
