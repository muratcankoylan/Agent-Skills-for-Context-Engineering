[Unit]
Description=Context research coordinator (pre-release, explicit live configuration)
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/srv/context-research/release/.git
ConditionPathExists=/etc/context-research/service.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=context-research
Group=context-research
UMask=0077
WorkingDirectory=/srv/context-research/release
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUTF8=1
Environment=RESEARCH_RELEASE_DIR=/srv/context-research/release
Environment=RESEARCH_DEPENDENCY_LOCK=/opt/context-research/requirements-dev.txt
Environment=RESEARCH_CODEX_DEPENDENCY_LOCK=/opt/context-research/requirements-codex-linux.txt
Environment=RESEARCH_CODEX_PYTHON=/opt/context-research/codex-venv/bin/python
EnvironmentFile=/etc/context-research/release.env
EnvironmentFile=/etc/context-research/worker.env
ExecStart=/opt/context-research/venv/bin/python -B /opt/context-research/launch.py serve --config /etc/context-research/service.json --state /var/lib/context-research --repo /srv/context-research/release --live
StateDirectory=context-research
StateDirectoryMode=0700
ReadOnlyPaths=/srv/context-research/release /opt/context-research /etc/context-research
ReadWritePaths=/var/lib/context-research
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
TimeoutStopSec=150
KillMode=control-group
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
