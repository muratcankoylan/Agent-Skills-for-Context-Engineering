    {"id": "duplicate-key", "input_json": "{\"a\":1,\"a\":2}", "valid": false, "expected_code": "DUPLICATE_KEY"},
    {"id": "float", "input_json": "{\"value\":1.5}", "valid": false, "expected_code": "UNSAFE_NUMBER"},
    {"id": "negative-zero", "input_json": "{\"value\":-0}", "valid": false, "expected_code": "UNSAFE_NUMBER"},
    {"id": "unsafe-integer", "input_json": "{\"value\":9007199254740992}", "valid": false, "expected_code": "UNSAFE_NUMBER"},
    {"id": "non-finite", "input_json": "{\"value\":NaN}", "valid": false, "expected_code": "UNSAFE_NUMBER"},
