{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muratcankoylan/Agent-Skills-for-Context-Engineering/researcher/schemas/v1/credential-ref.schema.json",
  "title": "CredentialRef 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "provider_key",
    "purpose",
    "allowed_operations",
    "owner_actor_id",
    "classification",
    "resolver_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^credref_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "kind": {"const": "CredentialRef"},
    "provider_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"}
    },
    "owner_actor_id": {"type": "string", "minLength": 1},
    "classification": {"const": "secret_reference"},
    "resolver_policy": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"}
  }
}
