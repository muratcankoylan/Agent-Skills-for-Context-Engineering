# Research service setup, 2026-09-29 UTC. No real secrets in this template.
# Copy to .env.local and set permissions to 0600. Never commit the filled file.
# Read docs/product/provider-credentials.md before obtaining paid access.
# Literal KEY=value syntax only; quote values containing spaces. No shell code,
# interpolation, export statements, backticks, escapes, or inline comments.

# Model key: not required by retrieval-only mode. No new model purchase needed.
OPENAI_API_KEY=
# The SDK uses this existing key only in the trusted gateway. Do not add a
# CODEX_API_KEY, desktop login, or provider key to a worker/container environment.
# Pass the pinned interpreter explicitly with --sdk-python /absolute/venv/bin/python.

# OPTIONAL METADATA-ONLY TRACING. Rotate any key pasted into chat.
# Create a project in Raindrop first; use its explicit lowercase slug.
# No global installer or daemon is required. Keys do not enable uploads.
# Preview locally, then use the explicit trace_cli export --live command.
# Or opt in to Organization post-cycle delivery with --trace-export;
# its explicitly configured default project needs --trace-allow-default-project.
# Run trace_cli preflight first. An explicitly configured default project also
# requires --allow-default-project; a blank project never falls back to default.
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=

# WIRED DAILY RETRIEVAL LANES
# Free OpenAlex account: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Official X app-only Bearer Token: https://console.x.com/
# Pilot recommendation: no more than $10 prepaid from the shared experiment budget.
# Disable auto-recharge; configure the account spending limit before live testing.
X_BEARER_TOKEN=

# NEXT WEB INTEGRATION: free signup first, not an enabled daily connector.
# https://platform.parallel.ai/signup . Provider spend limits notify, not block.
PARALLEL_API_KEY=

# OPTIONAL EXTRACTION: free signup only. Alexandria uses the Firecrawl key.
# https://www.firecrawl.dev/app/api-keys . Not wired into daily retrieval yet.
FIRECRAWL_API_KEY=

# ALTERNATIVES: no daily adapters; do not buy these now.
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional cross-provider evaluation, not needed for retrieval.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Future scholarly identification, not an API token or active request setting.
RESEARCH_CONTACT_EMAIL=

# Leave blank until an explicitly authorized staging publication/API setup.
# GitHub: one repo only; never administrator, workflow or delete permissions.
RESEARCH_GITHUB_TOKEN=
# Generate locally during operator API setup; never expose to browser JS.
RESEARCH_OPERATOR_TOKEN=

# Only this explicit source list selects daily lanes. Credentials do not enable
# anything. configure writes a JSON config; it never starts or schedules work.
RESEARCH_REPOSITORY=muratcankoylan/Agent-Skills-for-Context-Engineering
RESEARCH_RETRIEVAL_SOURCES=arxiv,hacker_news,huggingface
# Optional primary HTML reads per daily job (0..2), counted in request caps.
# Default off; keys alone never enable this stage or a scheduler.
RESEARCH_PRIMARY_READ_LIMIT=0
RESEARCH_RETRIEVAL_QUERY="Context engineering, agent memory, retrieval and evaluation"
RESEARCH_ARXIV_QUERY="agent memory"
RESEARCH_HN_QUERY=agent
RESEARCH_X_QUERY='("context engineering" OR "agent memory") -is:retweet lang:en'
RESEARCH_OPENALEX_QUERY="agent memory retrieval"

# Zero spend by default. Decimal USD only, at most six fractional places.
RESEARCH_RETRIEVAL_DAILY_BUDGET_USD=0
RESEARCH_RETRIEVAL_RUN_BUDGET_USD=0
RESEARCH_RETRIEVAL_DAILY_REQUESTS=8
RESEARCH_RETRIEVAL_RUN_REQUESTS=8
# Required before adding ,x,openalex to SOURCES: verified TOTAL request ceilings.
# These are conservative local reservations, not provider-enforced cost limits.
RESEARCH_X_MAX_REQUEST_USD=
RESEARCH_OPENALEX_MAX_REQUEST_USD=

# arXiv, HN and company feeds need no key. No universal MCP key, vector database
# subscription or cloud administrator credential is needed for this setup.
